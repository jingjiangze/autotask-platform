{
  "name": "autotask-central",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/1 * * * *",
      "0 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autotask-central",
      "database_id": "b5686aeb-e384-4888-ae00-dab996cc4a4b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "autotask-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "PathCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PathCoordinator"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "order.jiangjiangze.icu/*",
      "zone_name": "jiangjiangze.icu"
    },
    {
      "pattern": "chaxun.jiangjiangze.icu/*",
      "zone_name": "jiangjiangze.icu"
    }
  ]
}